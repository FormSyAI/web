# Optional external identity service. Leave disabled to keep the forms in demo mode.
# The service must allow this site's origin and support credentialed requests.
VITE_AURINOVA_AUTH_API_BASE_URL=
VITE_AURINOVA_AUTH_ENABLED=false

# Cloudflare Turnstile public key used by the signup page in live mode.
VITE_TURNSTILE_SITE_KEY=

# Approved legal documents. Local readiness notices are used while these are empty.
VITE_AURINOVA_TERMS_URL=
VITE_AURINOVA_DATA_AGREEMENT_URL=

# Reserved console service contract. Live pages remain gated pending integration.
VITE_AURINOVA_CONSOLE_API_BASE_URL=
VITE_AURINOVA_CONSOLE_ENABLED=false
