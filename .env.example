# Server-only origin for the future AURINOVA identity service.
# Example: https://identity.aurinova.example
AURINOVA_AUTH_API_BASE_URL=
AURINOVA_AUTH_ENABLED=false

# Comma-separated names of the host-only auth cookies the BFF may relay.
AURINOVA_AUTH_COOKIE_NAMES=__Host-aurinova_session,__Host-aurinova_refresh,__Host-aurinova_csrf

# Enable the browser client only after the server origin and OAuth callbacks are ready.
NEXT_PUBLIC_AURINOVA_AUTH_ENABLED=false

# Cloudflare Turnstile public key used by the signup page in live mode.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Approved legal documents. Local readiness notices are used while these are empty.
NEXT_PUBLIC_AURINOVA_TERMS_URL=
NEXT_PUBLIC_AURINOVA_DATA_AGREEMENT_URL=
